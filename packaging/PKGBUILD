# Maintainer: Facet authors
pkgname=facet
pkgver=1.0.0
pkgrel=1
pkgdesc='Know your machine: a hardware explorer for Linux (inspection only)'
arch=(x86_64)
url='https://github.com/last-refuge/omarchy-facet'
license=('MIT OR Apache-2.0')
depends=(wayland libxkbcommon libxkbcommon-x11 libxcb fontconfig freetype2 vulkan-icd-loader gcc-libs glibc)
makedepends=(cargo clang cmake git pkgconf)
optdepends=(
  'udisks2: drive health (SMART) details for storage'
  'hwdata: readable names for PCI and USB devices'
  'vulkan-driver: any Vulkan driver (vulkan-intel, vulkan-radeon, nvidia-utils)'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP') # replace with the real checksum for a tagged release

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p facet-cli -p facet-app
}

check() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo test --frozen --workspace
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/facet     "$pkgdir/usr/bin/facet"
  install -Dm755 target/release/facet-app "$pkgdir/usr/bin/facet-app"
  install -Dm644 packaging/dev.facet.Facet.desktop "$pkgdir/usr/share/applications/dev.facet.Facet.desktop"
  install -Dm644 assets/brand/facet.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.facet.Facet.svg"
  install -Dm644 README.md CHANGELOG.md docs/report-schema.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 LICENSE-MIT LICENSE-APACHE THIRD-PARTY-LICENSES.md -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 assets/fonts/IBMPlexSans-LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/IBMPlexSans-OFL.txt"
  install -Dm644 assets/fonts/Lilex-OFL.txt "$pkgdir/usr/share/licenses/$pkgname/Lilex-OFL.txt"
  install -Dm644 assets/icons/LICENSE "$pkgdir/usr/share/licenses/$pkgname/Lucide-ISC.txt"
}
